# ============================================================================
# V4Smart Factory Digital Twin — configuration (copy to .env before starting)
# ============================================================================

# ---- Public URLs ------------------------------------------------------------
# Point three DNS A-records at your host (a wildcard record works too).
# Caddy obtains certificates automatically; see README "Exposing the stack".
TWIN_HOST=twin.example.com
CONSOLE_HOST=console.example.com
QUESTDB_HOST=questdb.example.com
ACME_EMAIL=you@example.com

# ---- Basic auth -------------------------------------------------------------
# Generate the hash with:  make hash-password pw='YOUR_PASSWORD'
#
# IMPORTANT: escape every '$' as '$$' when pasting the hash here. Compose treats
# a bare '$' as a variable reference and silently truncates the hash (60 -> 40
# characters), which makes every login fail with 401 despite a correct password.
#   bcrypt output : $2a$14$abc...
#   value here    : $$2a$$14$$abc...
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# ---- Factory (simulator) ----------------------------------------------------
MACHINE_COUNT=8
TOTAL_RATE=2000            # messages per second across all machines
FACTORY_AUTO_START=true

# ---- Middleware core --------------------------------------------------------
DOWNSAMPLE_HZ=10           # sensor_clean rate per machine (feeds the ML service)
WS_TELEMETRY_HZ=5          # browser stream rate per machine

# ---- Predictive ML ----------------------------------------------------------
ML_WARMUP_S=60             # training window (normal operation) after start
ML_COOLDOWN_S=45           # per-machine lockout after a healing action
ML_VIB_GUARD=4.5           # deterministic safety net (mm/s RMS)
