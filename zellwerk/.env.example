# zellwerk — Konfiguration
# KEIN ANTHROPIC_API_KEY: der LLM-Zugang läuft über den Dienst zellwerk-llm,
# der das Claude-Max-Abo nutzt (siehe docs/decisions.md D1).

# --- Datenbank ---
ZW_DB_PASSWORD=zellwerk

# --- Broker / Dashboards ---
# ACHTUNG: Diese Werte sind Platzhalter für den lokalen Betrieb. Wer den Stack
# über den eigenen Rechner hinaus erreichbar macht, MUSS sie ersetzen.
# Beide wirken nur beim ERSTEN Start eines frischen Volumes; an einer
# bestehenden Installation ändert man sie mit:
#   grafana cli admin reset-admin-password <neues>
#   emqx ctl admins passwd admin <neues>
ZW_EMQX_PASSWORD=zellwerk-demo
ZW_GRAFANA_PASSWORD=zellwerk-demo

# --- Standort (Wurzel des UNS-Topic-Baums, SPEC §6.1) ---
ZW_SITE=werk1

# --- Öffentliche Adressen (nur nötig, wenn der edge-Proxy genutzt wird) ---
# Ohne diese Angaben läuft der Stack rein lokal.
# ZW_GRAFANA_ROOT_URL=https://dashboard.example.com
# ZW_GRAFANA_DOMAIN=dashboard.example.com
# ZELLWERK_HOST=dashboard.example.com
# ZW_AGENTS_HOST=agenten.example.com
# ZW_FACTORY_HOST=fabrik.example.com
# ZW_CONSOLE_HOST=broker.example.com
# BASIC_AUTH_USER=
# BASIC_AUTH_HASH=

# --- Simulation ---
ZW_TICK_S=1.0
# Zeitraffer für Demos: 1.0 = Echtzeit, 10.0 = zehnfach
ZW_SPEED=1.0

# --- KI-Schicht ---
# Basis-URL des LLM-Zugangs. Kein Schlüssel nötig.
ZW_LLM_BASE_URL=http://zellwerk-llm:4010
ZW_MODEL=claude-haiku-4-5-20251001
# Ausführende Aktionen bleiben im MVP AUS (SPEC §1, Shadow Mode first).
ZW_LIVE_ACTIONS=false
