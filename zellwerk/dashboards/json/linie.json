      "type": "timeseries",
      "title": "Mischer — Viskosität (Soll 2–6 Pa·s)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "zellwerk-timescale"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, value, name AS metric FROM measurement WHERE asset_id = 'mixer01' AND name = 'viskositaet_pas' AND $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2.0
              },
              {
                "color": "red",
                "value": 6.0
              }
            ]
          }
        },
